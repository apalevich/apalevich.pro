---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import Cta from "@components/cta.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="IT Recruitment for Technical Teams | APalevich.Pro" description="Senior developer and specialist placement. Hire hard-to-fill roles in weeks, not months. 93% probation pass rate.">
  <Container>
    <Sectionhead>
      <Fragment slot="title">IT Recruitment for Technical Teams</Fragment>
      <Fragment slot="desc">Access pre-vetted senior developers and specialists without months of wasted pipeline. We manage the full hiring process so your team stays focused on building.</Fragment>
    </Sectionhead>

    <!-- Who We Hire For -->
    <section class="mt-16 lg:mt-20">
      <h2 class="text-4xl font-bold mb-12">Who We Recruit</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="flex flex-col">
          <div class="flex items-start gap-4">
            <Icon size={32} name="bx:bxs-window-alt" class="text-primary flex-shrink-0 mt-1" />
            <div>
              <h3 class="text-xl font-semibold mb-2">Frontend Developers</h3>
              <p class="text-slate-600">React, Vue, TypeScript, and modern web frameworks. We find developers who can ship high-quality, maintainable UIs.</p>
            </div>
          </div>
        </div>
        <div class="flex flex-col">
          <div class="flex items-start gap-4">
            <Icon size={32} name="bx:bxs-bot" class="text-primary flex-shrink-0 mt-1" />
            <div>
              <h3 class="text-xl font-semibold mb-2">Backend & Full-Stack</h3>
              <p class="text-slate-600">Node.js, Golang, PHP, Python engineers. We specialize in finding seasoned backend talent that understands scalability.</p>
            </div>
          </div>
        </div>
        <div class="flex flex-col">
          <div class="flex items-start gap-4">
            <Icon size={32} name="bx:bxs-envelope" class="text-primary flex-shrink-0 mt-1" />
            <div>
              <h3 class="text-xl font-semibold mb-2">Mobile & DevOps</h3>
              <p class="text-slate-600">iOS, Android, React Native developers. Plus DevOps specialists, system architects, and technical analysts.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Proof Points -->
    <section class="mt-20 bg-gradient-to-br from-slate-50 to-slate-100 rounded-2xl p-12 md:p-16">
      <h2 class="text-4xl font-bold mb-16 text-center">Why We're Trusted</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center">
        <div>
          <p class="text-6xl font-bold text-primary mb-2">93%</p>
          <p class="text-slate-600">Probation pass rate (vs. 60% industry avg)</p>
        </div>
        <div>
          <p class="text-6xl font-bold text-primary mb-2">1.5 months</p>
          <p class="text-slate-600">Average time-to-hire (vs. 6+ month typical)</p>
        </div>
        <div>
          <p class="text-6xl font-bold text-primary mb-2">4x faster</p>
          <p class="text-slate-600">Process speed for rare/niche profiles</p>
        </div>
      </div>
    </section>

    <!-- Case Study Highlight -->
    <section class="mt-20">
      <h2 class="text-4xl font-bold mb-12">How We Work: A Real Example</h2>
      <div class="bg-white rounded-lg overflow-hidden border border-zinc-200">
        <div class="p-8 md:p-12 bg-gradient-to-r from-primary/5 to-secondary/5 border-b border-zinc-200">
          <p class="text-sm font-medium text-secondary mb-2">Case Study</p>
          <h3 class="text-3xl font-bold mb-4">Senior React + Conversational AI Engineer for Novakid</h3>
          <p class="text-slate-700 mb-4">Novakid, an AI education platform, needed a rare combination: a senior developer with React/TypeScript expertise AND proven production experience with conversational AI, voice interfaces, and NLP. Five agencies were already engaged. The role had been open for 3+ months.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-zinc-200">
          <!-- Our Approach -->
          <div class="p-8 md:p-12">
            <h4 class="font-semibold text-lg mb-4">Our Approach</h4>
            <ul class="space-y-3 text-slate-700">
              <li class="flex gap-3">
                <span class="text-primary font-bold flex-shrink-0">1.</span>
                <span><strong>Precision Brief:</strong> Understood not just the stack, but the business context and product goals.</span>
              </li>
              <li class="flex gap-3">
                <span class="text-primary font-bold flex-shrink-0">2.</span>
                <span><strong>Targeted Search:</strong> Focused headhunting for candidates with proven conversational AI production experience, not generic frontend profiles.</span>
              </li>
              <li class="flex gap-3">
                <span class="text-primary font-bold flex-shrink-0">3.</span>
                <span><strong>Tight Screening:</strong> High-bar early screening meant the team only interviewed strong, relevant finalists.</span>
              </li>
              <li class="flex gap-3">
                <span class="text-primary font-bold flex-shrink-0">4.</span>
                <span><strong>Offer Support:</strong> Negotiation and onboarding coordination through first week.</span>
              </li>
            </ul>
          </div>

          <!-- Results -->
          <div class="p-8 md:p-12">
            <h4 class="font-semibold text-lg mb-4">Results</h4>
            <ul class="space-y-3 text-slate-700">
              <li class="flex gap-3">
                <span class="text-secondary font-bold flex-shrink-0">✓</span>
                <span><strong>First candidates:</strong> Within 2 days of contract signature</span>
              </li>
              <li class="flex gap-3">
                <span class="text-secondary font-bold flex-shrink-0">✓</span>
                <span><strong>Total time-to-hire:</strong> 1.5 months (vs. 3+ months prior)</span>
              </li>
              <li class="flex gap-3">
                <span class="text-secondary font-bold flex-shrink-0">✓</span>
                <span><strong>Quality:</strong> 89 contacts → 17 HR interviews → 7 technical → 2 final → 1 offer → 1 hire</span>
              </li>
              <li class="flex gap-3">
                <span class="text-secondary font-bold flex-shrink-0">✓</span>
                <span><strong>Leadership time saved:</strong> ~60 hours due to smart screening</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Our Recruitment Process -->
    <section class="mt-20">
      <h2 class="text-4xl font-bold mb-12">Our Recruitment Process</h2>
      <div class="space-y-8">
        <div class="flex gap-6">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center h-12 w-12 rounded-md bg-primary text-white font-bold">1</div>
          </div>
          <div>
            <h3 class="text-xl font-semibold mb-2">Discovery & Hiring Brief</h3>
            <p class="text-slate-600">We deep-dive into your role, team, product stage, and what success looks like. Not just skills—the full context of why this hire matters.</p>
          </div>
        </div>
        <div class="flex gap-6">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center h-12 w-12 rounded-md bg-primary text-white font-bold">2</div>
          </div>
          <div>
            <h3 class="text-xl font-semibold mb-2">Candidate Profile & Search Strategy</h3>
            <p class="text-slate-600">We build a focused candidate profile and sourcing strategy. For rare roles, we combine direct headhunting with our network of trusted recruiters.</p>
          </div>
        </div>
        <div class="flex gap-6">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center h-12 w-12 rounded-md bg-primary text-white font-bold">3</div>
          </div>
          <div>
            <h3 class="text-xl font-semibold mb-2">Screening & Shortlist Management</h3>
            <p class="text-slate-600">We handle sourcing, outreach, and initial screening. Your team only meets strong candidates who clear our bar.</p>
          </div>
        </div>
        <div class="flex gap-6">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center h-12 w-12 rounded-md bg-primary text-white font-bold">4</div>
          </div>
          <div>
            <h3 class="text-xl font-semibold mb-2">Process Support & Hiring Recommendations</h3>
            <p class="text-slate-600">We advise on interview flow, help identify red flags, and recommend improvements to increase offer acceptance.</p>
          </div>
        </div>
        <div class="flex gap-6">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center h-12 w-12 rounded-md bg-primary text-white font-bold">5</div>
          </div>
          <div>
            <h3 class="text-xl font-semibold mb-2">Offer to Onboarding</h3>
            <p class="text-slate-600">We stay involved through offer negotiation and can support onboarding to ensure a smooth transition.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Who Should Work With Us -->
    <section class="mt-20">
      <h2 class="text-4xl font-bold mb-12">Good Fit Checklist</h2>
      <div class="space-y-4">
        <label class="flex items-start gap-3 p-4 bg-slate-50 rounded-lg cursor-pointer">
          <div class="flex-shrink-0 mt-1 text-primary font-bold">✓</div>
          <div>
            <p class="font-semibold">Hiring timelines have stalled</p>
            <p class="text-sm text-slate-600">You've been recruiting for weeks/months without results</p>
          </div>
        </label>
        <label class="flex items-start gap-3 p-4 bg-slate-50 rounded-lg cursor-pointer">
          <div class="flex-shrink-0 mt-1 text-primary font-bold">✓</div>
          <div>
            <p class="font-semibold">You need rare or specialized talent</p>
            <p class="text-sm text-slate-600">The profile is niche and hard to find (e.g., conversational AI + React)</p>
          </div>
        </label>
        <label class="flex items-start gap-3 p-4 bg-slate-50 rounded-lg cursor-pointer">
          <div class="flex-shrink-0 mt-1 text-primary font-bold">✓</div>
          <div>
            <p class="font-semibold">Your internal team needs help</p>
            <p class="text-sm text-slate-600">HR doesn't have deep tech recruitment expertise</p>
          </div>
        </label>
        <label class="flex items-start gap-3 p-4 bg-slate-50 rounded-lg cursor-pointer">
          <div class="flex-shrink-0 mt-1 text-primary font-bold">✓</div>
          <div>
            <p class="font-semibold">You want a predictable, managed process</p>
            <p class="text-sm text-slate-600">Fewer bad interviews, cleaner pipeline, smarter decisions</p>
          </div>
        </label>
      </div>
    </section>

    <Cta />
  </Container>
</Layout>
