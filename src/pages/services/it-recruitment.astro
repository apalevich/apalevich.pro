---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import Hero from "@components/hero.astro";
import Cta from "@components/cta.astro";
import Card from "@components/card.astro";
import { Icon } from "astro-icon/components";
import heroVictoria from "@images/hero-victoria.png";
---

<Layout
  title="Close Tech Roles 4x Faster | IT Recruiter for Startups and SMBs | APalevich.Pro"
  description="Hire technical talent in 1.5 months instead of 6. We handle recruitment end-to-end so you can focus on shipping. 93% probation pass rate."
>
  <Container>
    {/* Hero Section */}
    <Hero
      image={heroVictoria}
      imageAlt="Victoria"
      badge="IT Recruitment"
      headline="Stop Wasting 3 Months on Bad Hiring Pipelines"
      subheadline="White-glove recruitment for founders who are tired of slow hiring. We handle the entire process end-to-end. You focus on shipping."
      bullets={[
        "<strong>Speed:</strong> first candidates in 2 days, hire in 1.5 months",
        "<strong>Quality:</strong> 93% probation pass rate vs 60% industry average",
        "<strong>Specialties:</strong> web, mobile, backend, DevOps, analytics",
        "<strong>Global reach:</strong> access senior talent across time zones"
      ]}
      ctaPrimary={{ text: "Get Your First Candidates", href: "https://cal.com/apalevich/20min" }}
      ctaSecondary={{ text: "WhatsApp", href: "https://wa.me/995511106964", icon: "bx:bxl-whatsapp" }}
    />

    {/* Why We're Different Section */}
    <section class="mt-16 md:mt-24">
      <div class="max-w-3xl">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6">
          Why founders choose us for technical hiring
        </h2>
        <p class="text-base sm:text-lg text-slate-600 mb-6 leading-relaxed">
          Technical recruiting is broken for small teams. Most recruiters either don't understand code, or they spam you with 200 CVs. We're different: we combine deep technical knowledge with focused, autonomous recruitment.
        </p>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
          You get fewer, stronger candidates. Your team interviews only people who can actually do the job. We own the entire process. You stay involved in decisions that matter.
        </p>
      </div>
    </section>

    {/* Who We Recruit */}
    <section class="mt-16 md:mt-24">
      <Sectionhead align="left">
        <Fragment slot="title">Who we recruit</Fragment>
      </Sectionhead>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-12">
        {[
          { title: "Frontend engineers", desc: "React, TypeScript, modern frameworks. We find builders, not resume-matchers." },
          { title: "Full-stack engineers", desc: "Architects who understand both sides. Any tech stack." },
          { title: "Backend engineers", desc: "Node.js, Golang, PHP. Developers who ship at scale." },
          { title: "Mobile developers", desc: "Android, React Native. Proven shipping experience." },
          { title: "DevOps & infrastructure", desc: "System architects and specialists who own reliability." },
          { title: "Analysts", desc: "System and business analysts who bridge tech and product." }
        ].map(role => (
          <div class="p-4 border border-slate-200 rounded-lg">
            <h3 class="font-semibold text-base sm:text-lg mb-1">{role.title}</h3>
            <p class="text-sm text-slate-600">{role.desc}</p>
          </div>
        ))}
      </div>
    </section>

    {/* Why Companies Hire Us */}
    <section class="mt-16 md:mt-24">
      <Sectionhead align="left">
        <Fragment slot="title">Why companies hire us</Fragment>
      </Sectionhead>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12">
        {[
          {
            num: "1",
            title: "Fewer bad interviews, better candidates",
            desc: "We do the sourcing, screening, and coordination. Your team interviews only the people we'd personally recommend. Fewer wasted hours, higher quality finalists."
          },
          {
            num: "2",
            title: "Speed + quality combined",
            desc: "You get results fast. Typical time-to-hire: 1.5 months. We've closed roles in 3–4 weeks; we've handled rare profiles in 2 months when others needed 6."
          },
          {
            num: "3",
            title: "We own the entire process",
            desc: "From brief to start date, we handle it. Your team stays focused on shipping. We manage sourcing, screening, coordination, and offer negotiation so you don't have to."
          },
          {
            num: "4",
            title: "Reduce the cost of hiring mistakes",
            desc: "One bad technical hire costs $15k+. We reduce that risk with smarter screening and better fit assessment. You keep only the people who stick."
          }
        ].map(item => (
          <div class="relative pl-10">
            <div class="absolute left-0 top-0 h-8 w-8 bg-primary text-white rounded-full flex items-center justify-center text-sm font-bold">
              {item.num}
            </div>
            <h3 class="font-bold text-base sm:text-lg mb-2">{item.title}</h3>
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    {/* How We Work */}
    <section class="mt-16 md:mt-24">
      <Sectionhead align="left">
        <Fragment slot="title">How we work</Fragment>
      </Sectionhead>

      <div class="space-y-6 mt-12">
        {[
          {
            num: "1",
            title: "Discovery call and hiring brief",
            desc: "We learn the role, the team, and what success looks like. Not just the tech stack — the actual business context. That clarity drives better hiring."
          },
          {
            num: "2",
            title: "Candidate sourcing and search",
            desc: "We build a focused search strategy based on seniority, market realities, and rarity. Then we source: both from our network and through targeted headhunting."
          },
          {
            num: "3",
            title: "Screening and shortlist",
            desc: "We handle all sourcing, outreach, screening, and calibration. Your team only meets qualified finalists who clear our bar."
          },
          {
            num: "4",
            title: "Process support and offer",
            desc: "We advise on interview structure, help identify strong signals, and negotiate offer terms. You make the final call; we support the process."
          },
          {
            num: "5",
            title: "Start date and beyond",
            desc: "We stay involved through onboarding and can support through probation if needed. We want the hire to stick."
          }
        ].map(step => (
          <div class="flex gap-4 sm:gap-6">
            <div class="flex-shrink-0">
              <div class="h-10 w-10 sm:h-12 sm:w-12 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm sm:text-base">
                {step.num}
              </div>
            </div>
            <div class="flex-1 pt-1">
              <h3 class="font-bold text-base sm:text-lg mb-2">{step.title}</h3>
              <p class="text-sm sm:text-base text-slate-600 leading-relaxed">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* Recruitment Metrics */}
    <section class="mt-16 md:mt-24 bg-slate-50 rounded-2xl p-6 sm:p-8 lg:p-12">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold mb-3">We're efficient with your time</h2>
        <p class="text-slate-600 text-base sm:text-lg">Our typical funnel: strong candidates, fewer bad interviews, better outcomes.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 text-center">
        <div>
          <p class="text-4xl sm:text-5xl font-bold text-primary mb-2">3–6</p>
          <p class="text-sm sm:text-base text-slate-600">interviews to 1 hire</p>
        </div>
        <div>
          <p class="text-4xl sm:text-5xl font-bold text-primary mb-2">93%</p>
          <p class="text-sm sm:text-base text-slate-600">probation pass rate</p>
        </div>
        <div>
          <p class="text-4xl sm:text-5xl font-bold text-primary mb-2">1.5 mo</p>
          <p class="text-sm sm:text-base text-slate-600">average time-to-hire</p>
        </div>
      </div>
    </section>

    {/* Case Study */}
    <section class="mt-16 md:mt-24">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-8">Case study: Senior React engineer with AI experience for Novakid</h2>

      <div class="bg-white rounded-lg overflow-hidden border border-slate-200">
        {/* Header */}
        <div class="p-6 sm:p-8 lg:p-12 bg-gradient-to-r from-primary/5 to-secondary/5 border-b border-slate-200">
          <p class="text-sm font-medium text-secondary mb-2">The Challenge</p>
          <p class="text-base sm:text-lg text-slate-700 leading-relaxed">
            Novakid needed a rare profile: senior React engineer with hands-on conversational AI and voice interface experience. After 3+ months with five competing agencies, the role was still open. The clock was ticking on their product launch.
          </p>
        </div>

        {/* Two-Column Grid on Desktop */}
        <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-slate-200">
          {/* Approach */}
          <div class="p-6 sm:p-8 lg:p-12">
            <h3 class="font-bold text-lg sm:text-xl mb-6">What We Did</h3>
            <ul class="space-y-4">
              {[
                { title: "Built a detailed brief", desc: "Understood the business context and success criteria, not just the stack" },
                { title: "Targeted sourcing", desc: "Headhunted candidates with proven conversational AI + production experience" },
                { title: "High-bar screening", desc: "Tight early screening so their team only met strong candidates" },
                { title: "Fast process", desc: "Smart coordination from brief to offer" }
              ].map(item => (
                <div>
                  <p class="font-semibold text-sm sm:text-base">{item.title}</p>
                  <p class="text-sm text-slate-600 mt-1">{item.desc}</p>
                </div>
              ))}
            </ul>
          </div>

          {/* Results */}
          <div class="p-6 sm:p-8 lg:p-12">
            <h3 class="font-bold text-lg sm:text-xl mb-6">Results</h3>
            <ul class="space-y-3">
              {[
                { label: "First candidates:", value: "within 2 days" },
                { label: "Search time:", value: "1 month" },
                { label: "Time to start:", value: "2 weeks" },
                { label: "Total time-to-hire:", value: "1.5 months" },
                { label: "Pipeline efficiency:", value: "89 → 17 → 7 → 2 → 1 → 1" },
                { label: "Leadership time saved:", value: "~60 hours" }
              ].map(item => (
                <div class="flex justify-between text-sm sm:text-base">
                  <span class="font-semibold text-slate-700">{item.label}</span>
                  <span class="text-slate-600">{item.value}</span>
                </div>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* You Might Be a Fit If... */}
    <section class="mt-16 md:mt-24">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-8">You might be a fit if...</h2>

      <div class="space-y-3">
        {[
          { title: "Hiring has stalled", desc: "Weeks or months with no results, and you need action now" },
          { title: "Your internal team is stretched", desc: "You don't have HR resources for technical recruiting" },
          { title: "You need a rare profile", desc: "The role is niche, and generic recruiters aren't finding anyone" },
          { title: "You're tired of bad interviews", desc: "Too many irrelevant CVs, wasted time with poor fits" },
          { title: "Time-to-hire matters", desc: "You can't afford 3-6 more months of recruiting" },
          { title: "You want quality, not volume", desc: "Fewer finalists, but stronger candidates" }
        ].map(item => (
          <label class="flex items-start gap-3 p-4 bg-slate-50 rounded-lg cursor-pointer hover:bg-slate-100 transition">
            <div class="flex-shrink-0 mt-0.5 text-primary font-bold text-lg">✓</div>
            <div>
              <p class="font-semibold text-base">{item.title}</p>
              <p class="text-sm text-slate-600 mt-1">{item.desc}</p>
            </div>
          </label>
        ))}
      </div>
    </section>

    {/* FAQ */}
    <section class="mt-16 md:mt-24">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-8">Questions?</h2>

      <div class="space-y-6">
        {[
          { q: "Do you work with startups only?", a: "No. Startups, SMBs, product teams, and custom software companies. Anywhere you need strong technical hiring." },
          { q: "Do you hire only developers?", a: "Developers, analysts, DevOps, architects. Web, mobile, backend, infrastructure. If it's technical, we can help." },
          { q: "Can you find rare profiles?", a: "Yes. That's a core strength. The rarer the role, the more valuable our network and focused approach." },
          { q: "Do we do the technical interviews?", a: "Yes, usually. We handle sourcing and screening; you assess the technical fit. If you need help interviewing, we can advise." }
        ].map(faq => (
          <div class="border-l-2 border-primary pl-6 py-2">
            <h3 class="font-bold text-base sm:text-lg mb-2">{faq.q}</h3>
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </section>

    {/* Final CTA Section */}
    <section class="mt-16 md:mt-24 py-8">
      <div class="max-w-3xl">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6">
          Ready to close your technical roles faster?
        </h2>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
          Let's talk about your open role and how we can help you hire stronger talent in weeks, not months.
        </p>
      </div>
    </section>

    <Cta />
  </Container>
</Layout>
