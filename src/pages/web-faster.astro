---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import WebVitalsAnalyzer from "@components/WebVitalsAnalyzer";
---

<Layout title="Free Web Vitals Recommendations | APalevich.Pro">
  <Container>
    <Sectionhead>
        <Fragment slot="title">Slow Websites Lose Traffic, Leads, and&nbsp;Sales</Fragment>
        <Fragment slot="desc">
            <p class="hidden md:block">Website speed affects SEO, conversion, and campaign performance.</p>
            Submit your website, and get a practical set of recommendations to improve your Core Web Vitals.
        </Fragment>
    </Sectionhead>

    <div class="mx-auto max-w-2xl mt-16 mb-24">
      <WebVitalsAnalyzer client:load />
    </div>

    <div class="text-center mb-16">
      <a href="/" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-primary hover:gap-2.5 transition-all duration-300">
        ← Home page
      </a>
    </div>
  </Container>
</Layout>

<style is:global>
  /* === 3D Spinner Animations === */
  @keyframes spin3D {
    from {
      transform: rotate3d(0.5, 0.5, 0.5, 0deg);
    }
    to {
      transform: rotate3d(0.5, 0.5, 0.5, 360deg);
    }
  }

  @keyframes pulse-glow {
    0%, 100% {
      box-shadow: 0 0 20px rgba(8, 73, 74, 0.4), inset 0 0 20px rgba(8, 73, 74, 0.1);
    }
    50% {
      box-shadow: 0 0 40px rgba(8, 73, 74, 0.6), inset 0 0 30px rgba(8, 73, 74, 0.15);
    }
  }

  .spinner-box {
    width: 280px;
    height: 280px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: radial-gradient(circle, rgba(8, 73, 74, 0.05) 0%, transparent 70%);
    border-radius: 50%;
    position: relative;
  }

  .leo {
    position: absolute;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
  }

  .blue-orbit {
    width: 180px;
    height: 180px;
    border: 1.5px solid rgba(8, 73, 74, 0.3);
    -webkit-animation: spin3D 4s linear infinite;
    animation: spin3D 4s linear infinite;
  }

  .green-orbit {
    width: 120px;
    height: 120px;
    border: 2px solid rgba(8, 73, 74, 0.5);
    -webkit-animation: spin3D 2.5s linear infinite reverse;
    animation: spin3D 2.5s linear infinite reverse;
  }

  .red-orbit {
    width: 70px;
    height: 70px;
    border: 2px solid rgba(74, 9, 8, 0.4);
    -webkit-animation: spin3D 1.5s linear infinite;
    animation: spin3D 1.5s linear infinite;
  }

  .w1 {
    transform: rotate3D(1, 1, 1, 90deg);
  }

  .w2 {
    transform: rotate3D(1, 2, 0.5, 90deg);
  }

  .w3 {
    transform: rotate3D(0.5, 1, 2, 90deg);
  }

  /* === Form Animations === */
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes input-focus-glow {
    0% {
      box-shadow: inset 0 0 0 2px rgba(8, 73, 74, 0.2), 0 0 0 0 rgba(8, 73, 74, 0.1);
    }
    100% {
      box-shadow: inset 0 0 0 2px rgba(8, 73, 74, 1), 0 0 20px rgba(8, 73, 74, 0.2);
    }
  }

  .wva-form {
    animation: fade-in-up 0.6s ease-out;
  }

  .wva-form input:focus {
    animation: input-focus-glow 0.3s ease-out forwards;
  }

  /* === Message Animations === */
  @keyframes wva-fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .wva-fade-in {
    animation: wva-fade-in 0.5s ease-out;
  }

  /* === Button Animations === */
  @keyframes button-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(8, 73, 74, 0.7);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(8, 73, 74, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(8, 73, 74, 0);
    }
  }

  .wva-button-ready:hover {
    animation: button-pulse 1.5s infinite;
  }

  /* === Code Element Wrapping === */
  code {
    word-break: break-word;
    overflow-wrap: break-word;
    word-wrap: break-word;
    display: block;
    white-space: pre-wrap;
  }

  pre code {
    display: block;
    overflow-x: auto;
    max-width: 100%;
  }
</style>
