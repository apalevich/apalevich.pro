---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import WebVitalsAnalyzer from "@components/WebVitalsAnalyzer";
---

<Layout title="Free Web Vitals Analysis | APalevich.Pro">
  <Container>
    <Sectionhead>
      <Fragment slot="title">We Make Web Faster</Fragment>
      <Fragment slot="desc">
        Enter your website and we'll run a free Core Web Vitals audit —
        then send you a personalized improvement plan.
      </Fragment>
    </Sectionhead>

    <div class="mx-auto max-w-2xl mt-12 mb-20">
      <WebVitalsAnalyzer client:load />
    </div>

    <div class="text-center mt-8 mb-16">
      <a href="/" class="text-sm text-slate-500 hover:text-primary transition">
        &larr; Back to home
      </a>
    </div>
  </Container>
</Layout>

<style is:global>
    @keyframes spin {
    from {
        transform: rotate(0);
    }
    to{
        transform: rotate(359deg);
    }
    }

    @keyframes spin3D {
    from {
        transform: rotate3d(.5,.5,.5, 360deg);
    }
    to{
        transform: rotate3d(0deg);
    }
    }

    .spinner-box {
    width: 300px;
    height: 300px;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: transparent;
    }

    .leo {
    	position: absolute;
    	display: flex;
    	justify-content: center;
    	align-items: center;
    	border-radius: 50%;
    }

    .blue-orbit {
       	width: 165px;
       	height: 165px;
        border: 1px solid #a1a1aa;
        -webkit-animation: spin3D 3s linear .2s infinite;
    }

    .green-orbit {
       	width: 120px;
       	height: 120px;
        border: 1px solid #109698;
        -webkit-animation: spin3D 2s linear 0s infinite;
    }

    .red-orbit {
       	width: 90px;
       	height: 90px;
        border: 2px solid #F39291;
        -webkit-animation: spin3D 1s linear 0s infinite;
    }

    .w1 {
    transform: rotate3D(1, 1, 1, 90deg);
    }

    .w2 {
    transform: rotate3D(1, 2, .5, 90deg);
    }

    .w3 {
    transform: rotate3D(.5, 1, 2, 90deg);
    }
</style>
