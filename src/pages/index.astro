---
import BaseLayout from "../components/layout/BaseLayout.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import HeroSection from "../components/home/HeroSection.astro";
import StatsSection from "../components/home/StatsSection.astro";
import ClientsSection from "../components/home/ClientsSection.astro";
import TestimonialsSection from "../components/home/TestimonialsSection.astro";
import ContentSplitSection from "../components/home/ContentSplitSection.astro";
import ServicesSection from "../components/home/ServicesSection.astro";
import PricingSection from "../components/home/PricingSection.astro";
import TeamSection from "../components/home/TeamSection.astro";
import BlogSection from "../components/home/BlogSection.astro";
import CtaSection from "../components/home/CtaSection.astro";
import data from "../data/homepage.json";
import { graph, organizationNode, websiteNode } from "../utils/schema";

const schema = graph([
  organizationNode(),
  websiteNode(),
  {
    "@type": "ItemList",
    name: "Services offered by APalevich.Pro",
    itemListElement: data.services.cards.map((card, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `https://apalevich.pro${card.href}`,
      name: card.title.replace(/\{[^}]+\}/g, " ").replace(/\s+/g, " ").trim(),
    })),
  },
]);
---

<BaseLayout
  title={data.site.title}
  description={data.site.description}
  image={data.site.ogImage}
  schema={schema}
  scripts={[
    "/assets/js/menu.js",
    "/assets/js/countdown.js",
    "/assets/js/counterup.js",
    "/assets/js/main.js",
  ]}>
  <div class="relative z-1 bg-ColorLight">
    <SiteHeader navigation={data.navigation} theme="light" />

    <main class="relative overflow-hidden">
      <HeroSection hero={data.hero} />
      <ClientsSection clients={data.clients} dark />
      <StatsSection stats={data.stats} />
      <ServicesSection services={data.services} />
      <ContentSplitSection block={data.speed} checklist />
      <ContentSplitSection block={data.story} reverse />
      <ContentSplitSection block={data.process} />
      <TeamSection team={data.team} />
      <TestimonialsSection testimonials={data.testimonials} dark />
      <CtaSection cta={data.cta} />
      <BlogSection blog={data.blog} />
      <!-- <PricingSection pricing={data.pricing} /> -->
    </main>

    <SiteFooter footer={data.footer} logo={data.navigation.logo} />
  </div>
</BaseLayout>
