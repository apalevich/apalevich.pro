---
import BaseLayout from "../components/layout/BaseLayout.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import ServiceHeroSection from "../components/service/ServiceHeroSection.astro";
import ServiceFeaturesSection from "../components/service/ServiceFeaturesSection.astro";
import ContentSplitSection from "../components/home/ContentSplitSection.astro";
import StatsSection from "../components/home/StatsSection.astro";
import CtaSection from "../components/home/CtaSection.astro";
import navigation from "../data/homepage.json";
import { graph, organizationNode, serviceNode, breadcrumb } from "../utils/schema";

export async function getStaticPaths() {
  const services = [
    "frontend-development",
    "backend-development",
    "ai",
    "design",
    "seo",
  ];

  return await Promise.all(
    services.map(async (slug) => {
      const data = await import(`../data/services/${slug}.json`);
      return { params: { service: slug }, props: { data: data.default } };
    })
  );
}

const { data } = Astro.props;
const { service } = Astro.params;

const cleanTitle = (s) => s.replace(/\{[^}]+\}/g, " ").replace(/\s+/g, " ").trim();

const schema = graph([
  organizationNode(),
  serviceNode({
    name: cleanTitle(data.hero.title),
    description: data.meta.description,
    url: `/${service}`,
    image: data.meta.ogImage,
    serviceType: data.hero.eyebrow,
  }),
  breadcrumb([
    { name: "Home", path: "/" },
    { name: cleanTitle(data.hero.eyebrow || data.hero.title), path: `/${service}` },
  ]),
]);
---

<BaseLayout
  title={data.meta.title}
  description={data.meta.description}
  image={data.meta.ogImage}
  schema={schema}
  scripts={[
    "/assets/js/menu.js",
    "/assets/js/counterup.js",
    "/assets/js/main.js",
  ]}
>
  <div class="relative z-1 bg-ColorLight">
    <SiteHeader navigation={navigation.navigation} theme="dark" />

    <main class="relative overflow-hidden">
      <ServiceHeroSection hero={data.hero} />
      <ServiceFeaturesSection features={data.features} />
      <ContentSplitSection block={data.approach} checklist />
      <StatsSection stats={data.stats} />
      <CtaSection cta={data.cta} />
    </main>

    <SiteFooter footer={navigation.footer} logo={navigation.navigation.logo} />
  </div>
</BaseLayout>
