---
import Contactform from "@components/contactform.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Contact">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Contact</Fragment>
      <Fragment slot="desc">Let’s Discuss Your Project</Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl mt-4">
      <div>
        <div class="mt-5">
          <div class="flex items-center mt-2 space-x-2 text-gray-600">
            <Icon class="text-gray-400 w-4 h-4" name="uil:envelope" /><a
              href="mailto:hello@apalevich.com"
              >hello@apalevich.com</a
            >
          </div><div class="flex items-center mt-2 space-x-2 text-gray-600">
            <Icon class="text-gray-400 w-4 h-4" name="uil:linkedin" /><a
              href="https://www.linkedin.com/company/apalevich-pro/"
              target="_blank">LinkedIn</a
            >
          </div><div class="flex items-center mt-2 space-x-2 text-gray-600">
            <Icon class="text-gray-400 w-4 h-4" name="uil:message" /><a
              href="https://wa.me/995511106964"
              target="_blank">WhatsApp</a
            >
          </div>
        </div>
      </div>
      <div>
        <Contactform />
      </div>
      <div>
          <h2 class="font-medium text-2xl text-gray-800">Need a CTO-Level Perspective?</h2>
          <p class="text-lg leading-relaxed text-slate-500 mt-3">
              Some projects need more than development alone. We bring structure to technical decisions, align implementation with business priorities, and move projects forward without unnecessary complexity.
          </p>
      </div>
    </div>
  </Container>
</Layout>
