---
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { renderCopy } from "../../utils/copy";

const { services } = Astro.props;
---

<Section tone="dark" id="services">
    <div class="container py-16 lg:py-20">
        <div class="mx-auto mb-15 max-w-175 text-center xl:mb-20">
            <SectionHeading
                title={services.eyebrow}
                description={services.description}
                tone="light"
                align="center"
            />
        </div>

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {
                services.cards.map((card, index) => {
                    const Tag = card.href ? "a" : "article";
                    const linkProps = card.href ? { href: card.href } : {};
                    return (
                        <Tag
                            {...linkProps}
                            class="flex flex-col rounded-md border border-white/10 bg-white/5 p-6 transition hover:-translate-y-1 hover:bg-white/10"
                        >
                            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-ColorLime text-ColorBlack">
                                {String(index + 1).padStart(2, "0")}
                            </div>
                            <h3
                                class="mb-3 font-PublicSans text-2xl font-bold leading-tight text-ColorLight"
                                set:html={renderCopy(card.title)}
                            />
                            {card.outcome && (
                                <p
                                    class="mb-4 text-base leading-relaxed text-ColorLight/80"
                                    set:html={renderCopy(card.outcome)}
                                />
                            )}
                            {card.risk && (
                                <p class="hidden mt-auto border-t border-white/10 pt-4 text-sm leading-relaxed text-ColorLight/60">
                                    <span class="font-semibold text-ColorLime">
                                        {services.riskLabel ?? "Risk of doing it badly:"}
                                    </span>{" "}
                                    <span set:html={renderCopy(card.risk)} />
                                </p>
                            )}
                        </Tag>
                    );
                })
            }
        </div>
    </div>
</Section>
