---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { renderCopy } from '../../utils/copy';

const { stats, dark = false } = Astro.props;
---
<Section tone={dark ? 'dark' : 'light'}>
  <div class="container py-16 lg:py-20">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 xl:grid-cols-[0.8fr_minmax(0,_1fr)] xl:gap-20 xxl:gap-[100px]">
      <SectionHeading title={stats.title} tone={dark ? 'light' : 'dark'} align="center" class="lg:text-left" />
      <div class="grid grid-cols-1 gap-y-6 sm:grid-cols-3">
        {stats.items.map((item, index) => (
          <div class="relative px-0 text-center sm:px-10 first:pl-0 last:pr-0 sm:after:absolute sm:after:left-full sm:after:top-1/2 sm:after:block sm:after:h-10 sm:after:w-0.5 sm:after:-translate-y-1/2 sm:after:bg-ColorLime last:sm:after:hidden">
            <div class:list={["mb-[5px] font-PublicSans text-5xl font-bold leading-[1.14] xl:text-[56px] text-nowrap", dark ? 'text-ColorLight' : 'text-ColorBlack']} data-module="countup">
              <span class="start-number" data-countup-number={item.value}>{item.value}</span>
              {item.suffix}
            </div>
            <span class:list={dark ? 'text-ColorLight/60' : 'text-ColorBlack/60'} set:html={renderCopy(item.label)} />
          </div>
        ))}
      </div>
    </div>
  </div>
</Section>
