---
const { name, class: className = '' } = Astro.props;

const icons = {
  'arrow-right': 'M5 12h14m0 0-6-6m6 6-6 6',
  'badge': 'M12 3l2.45 5.27 5.8.85-4.2 4.09.99 5.78L12 16.91 6.96 19l.99-5.78-4.2-4.09 5.8-.85L12 3z',
  'calendar': 'M7 2v3m10-3v3M4 7h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z',
  'check': 'M20 6 9 17l-5-5',
  'chevron-down': 'M6 9l6 6 6-6',
  'chevron-left': 'M14 6l-6 6 6 6',
  'circle-user': 'M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm7 8a7 7 0 1 0-14 0',
  'facebook-f': 'M14 8h2V5h-2c-2.2 0-4 1.8-4 4v2H7v3h3v8h3v-8h3l1-3h-4V9c0-.6.4-1 1-1z',
  'fire': 'M12 22a6 6 0 0 0 6-6c0-4-2.5-5.5-4-8 0 2-1 3-3 4-1.8-2-2-4-2-4S6 9 6 15a6 6 0 0 0 6 7z',
  'github': 'M9 19c-4.5 1.5-4.5-2-6-2m12 4v-3.5c0-1 .1-1.4-.5-2 2.1-.2 4.3-1 4.3-4.5 0-1-.4-2-1.1-2.8.1-.3.5-1.4-.1-2.8 0 0-1-.3-3.2 1.1a10.5 10.5 0 0 0-5.8 0C6.4 4.9 5.4 5.2 5.4 5.2c-.6 1.4-.2 2.5-.1 2.8A4.2 4.2 0 0 0 4.2 10.8c0 3.5 2.2 4.3 4.3 4.5-.5.5-.6 1.1-.5 2V21',
  'linkedin': 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  'menu': 'M4 7h16M4 12h16M4 17h16',
  'play': 'M10 8l6 4-6 4V8z',
  'x': 'M6 6l12 12M18 6 6 18',
  'x-twitter': 'M4 4l6.7 9.1L4 20h2.7l5.5-6.6L17.2 20H20l-7-9.4L20 4h-2.7l-5.2 6.1L7.9 4H4z'
};
---
<svg
  aria-hidden="true"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
>
  {name === 'facebook-f' || name === 'linkedin' || name === 'github' || name === 'x-twitter' ? (
    <path d={icons[name]} fill="currentColor" stroke="none" />
  ) : (
    <path d={icons[name] ?? icons['arrow-right']} />
  )}
</svg>
