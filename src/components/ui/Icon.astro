---
<svg
  aria-hidden="true"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
>
  {filledIcons.has(name) ? (
    <path d={icons[name]} fill="currentColor" stroke="none" />
  ) : (
    <path d={icons[name] ?? icons['arrow-right']} />
  )}
</svg>
