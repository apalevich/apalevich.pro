---
// @ts-ignore
import { Icon } from "astro-icon/components";
import Card from "./card.astro";

const featuresBackup = [
  {
    title: "Marketing Web Development",
    description: "Rapid development of high-converting websites and newsletters with seamless marketing tool integration. Get your marketing assets launched in days, not weeks, with guaranteed performance and mobile responsiveness.",
    icon: "bx:bxs-window-alt",
  },
  {
    title: "AI Agent & Automatization",
    description: "Optimize your business processes with AI automation for improved performance and reduced operational costs. Our AI agents handle internal communication, task management, and maintenance while your team focuses on growth.",
    icon: "bx:bxs-bot",
  },
  {
    title: "Technical Talent Acquisition",
    description: "Access pre-vetted senior developers and technical experts within 2 weeks. Each candidate goes through rigorous technical assessment and comes with a 30-day satisfaction guarantee.",
    icon: "bx:bxs-user",
  },
];

const features = [
  {
    title: "Technical Development & Implementation",
    subtitle: "Ship production-ready projects in weeks",
    description: "Build modern web applications and websites from concept to production. We specialize in integrating AI solutions, optimizing architecture for scale, and delivering full-cycle development with post-launch support. Average project: 4 weeks to launch.",
    icon: "bx:bxs-window-alt",
    href: "/services/technical-development",
  },
  {
    title: "Product & UX Optimization",
    subtitle: "Core Web Vitals 90+ guaranteed",
    description: "Transform underperforming products into revenue drivers. We optimize infrastructure, reduce load times, improve Core Web Vitals, and enhance SEO—often delivering measurable improvements in weeks, not months. Average improvement: 40% faster load times.",
    icon: "bx:bxs-bolt",
    href: "/services/product-optimization",
  },
  {
    title: "IT Recruitment for Technical Teams",
    subtitle: "First candidates within 2 days",
    description: "Access pre-vetted senior developers and specialists without months of wasted pipeline. First candidates delivered within 2 days after contract signature. Total time-to-hire: 1.5 months. Leadership time saved: approximately 60 hours per hire.",
    icon: "bx:bxs-user-check",
    href: "/services/it-recruitment",
  },
];
---

<div class="mt-16 md:mt-0">
  <!-- <h2 class="bg-gradient-to-r from-primary-500 to-secondary-500 bg-clip-text text-transparent text-4xl lg:text-5xl font-bold lg:tracking-tight"> -->
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
    Technical solutions built on your business&nbsp;results
  </h2>
  <!-- <p class="text-lg mt-4 text-slate-600">
    We provide custom web development that turns your vision into high-converting digital experiences
  </p> -->
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 my-16 lg:my-8 gap-4 lg:px-8 ">
  {
    features.map(({title, subtitle, description, icon, href}) => (
      <a href={href} class="block group hover:opacity-80 transition-opacity">
        <Card text={description}>
          <div class="flex-1" slot="heading">
            <h2 class="text-4xl lg:text-5xl font-semibold group-hover:text-primary transition-colors" set:text={title} />
            <p
                class="mt-1 text-base lg:text-lg font-normal text-gray-500 opacity-50"
                set:text={subtitle}
            />
          </div>

          {/* <Fragment slot="links">
              <a
                  class="text-link  lg:text-lg"
                  href="https://github.com/apalevich"
                  target="_blank"
                  aria-label="Open in new tab">GitHub</a
              > /
              <a
                  class="text-link  lg:text-lg"
                  href="https://linkedin.com/in/apalevich/"
                  target="_blank"
                  aria-label="Open in new tab">LinkedIn</a
              >
          </Fragment> */}
          <Icon size={145} class="text-white" name={icon} slot="icon" />
        </Card>
      </a>
    ))
  }
</div>
